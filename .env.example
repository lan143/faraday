# Local OTA settings for the faraday_ota environment.
# Copy this file to .env, fill in the real values, and never commit .env.
# FARADAY_OTA_AUTH is injected into the firmware at build time for the
# faraday_ota env, so it always matches the ArduinoOTA password.
# FARADAY_OTA_AUTH must not contain double-quote or backslash characters.
FARADAY_OTA_IP=192.168.1.xx
FARADAY_OTA_AUTH=change-me
